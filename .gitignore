*.nbi
*.nbc

# --- Package install (pip install -e .) ------------------------------------ #
*.egg-info/
build/
dist/

# --- Tests ----------------------------------------------------------------- #
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

